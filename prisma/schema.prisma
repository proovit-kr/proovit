}

// ═════════════════════════════════════════════════════════════
// A. 인증 · 권한
// ═════════════════════════════════════════════════════════════

model User {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email    String @unique @db.Citext
  name     String @db.VarChar(60)
  /// 리더보드·참가작 페이지에 노출되는 이름. 실명(name)과 분리한다.
  /// ⚠️ @unique가 없다 — 상위 팀 닉네임을 그대로 쓰는 사칭이 성립한다.
  /// 지금은 앱에서만 막고 있어 동시 제출이면 둘 다 통과한다. 8/17 안건 2-1.
  nickname String @db.VarChar(60)

  /// 알림톡 발송처. 카카오 동의항목으로만 채워진다(카카오가 인증한 값).
  /// 구글 가입자와 번호 미동의자는 null이고 이메일·인앱으로만 통지한다.
  phone     String? @db.VarChar(20)
  avatarUrl String? @map("avatar_url")

  /// 마케팅 동의와 별개인 서비스 알림(마감 통지·판정 결과).
  /// 마감 통지는 분쟁의 근거가 되므로 끄더라도 법정 통지는 별도로 나간다.
  notifyEmail    Boolean @default(true) @map("notify_email")
  /// phone이 null이면 발송 불가
  notifyAlimtalk Boolean @default(false) @map("notify_alimtalk")

  /// 소셜 제공자가 인증해 넘겨준 이메일을 받은 시각. 우리가 인증 메일을 보내지 않는다.
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(6)
  /// 추가정보 입력 완료 시각. null이면 온보딩 화면을 다시 띄운다.
  onboardedAt     DateTime? @map("onboarded_at") @db.Timestamptz(6)
  /// 탈퇴한 시각. 탈퇴하면 이메일·이름·전화·소셜 연결을 지워 익명화하고 행은 남긴다 —
  /// 참가·판정·제재 기록이 이 행을 가리키고, 운영 규정대로 보관한 뒤 지운다.
  withdrawnAt     DateTime? @map("withdrawn_at") @db.Timestamptz(6)

  oauthAccounts        OauthAccount[]
  sessions             Session[]
  userRoles            UserRole[]
  consents             Consent[]
  teamMembers          TeamMember[]
  notifications        Notification[]
  auditLogs            AuditLog[]
  appliedSchedules     SeasonSchedule[]
  judgments            Judgment[]
  submissions          Submission[]
  reviewedMetrics      MetricDaily[]
  excludedTransactions Transaction[]
  reviewedAbuseFlags   AbuseFlag[]
  complianceRecords    ComplianceViolation[]
  ipBlocks             IpBlocklist[]
  decidedSanctions     Sanction[]
  respondedAppeals     Appeal[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("users")
}

model OauthAccount {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String        @map("user_id") @db.Uuid
  provider          OauthProvider
  /// 소셜 제공자가 그 사용자에게 붙인 고유 번호
  providerAccountId String        @map("provider_account_id") @db.VarChar(255)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("oauth_accounts")
}

/// 역할을 enum이 아니라 테이블로 두는 이유: 심사위원·스폰서처럼 시즌마다
/// 생기고 사라지는 역할이 있어서, 값을 추가할 때 마이그레이션이 필요하면 안 된다.
model Role {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// participant / admin / mentor / judge / sponsor — 코드가 읽는 값
  key         String  @unique @db.VarChar(30)
  /// 사람이 읽는 표시명
  name        String  @db.VarChar(60)
  description String?

  userRoles UserRole[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("roles")
}

model UserRole {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId   String  @map("user_id") @db.Uuid
  roleId   String  @map("role_id") @db.Uuid
  /// null = 전역 역할(시즌과 무관한 운영자).
  /// 시즌 종속 테이블은 seasonId를 갖는다는 규칙의 유일한 예외다 —
  /// 운영자 권한이 시즌마다 끊기면 시즌 사이에 아무도 못 들어온다.
  seasonId String? @map("season_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id])

  /// ⚠️ Cascade여야 한다. Prisma 기본값(SET NULL)을 쓰면 시즌이 지워질 때
  /// season_id가 null이 되는데, 이 표에서 null은 "전역 역할"을 뜻한다.
  /// 즉 시즌1 심사위원이 조용히 전 시즌 심사위원으로 승격된다.
  season Season? @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([userId, roleId, seasonId])
  @@map("user_roles")
}

/// Auth.js DB 세션. JWT를 쓰지 않는 이유는 실격 시 즉시 무효화가 요건이기
/// 때문이다 — JWT는 만료 전까지 서버가 회수할 수 없다.
model Session {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id") @db.Uuid
  expires      DateTime @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// ⚠️ 종결본에 없다. 지우지 않은 이유는 파일 머리 주석 1번 참조 —
/// Auth.js 어댑터 인터페이스가 요구하고, 이메일 코드 로그인의 자리다.
/// 가입 전에도 발급되므로 users.id를 참조하지 않는다(참조할 행이 아직 없다).
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime @db.Timestamptz(6)

  @@id([identifier, token])
  @@map("verification_tokens")
}

/// append-only 로그. 같은 (user, type)에 여러 행이 쌓이고 가장 최근 행이 최종 상태다.
/// 철회를 UPDATE로 덮으면 "그때 무엇에 동의했는지"가 사라져 입증이 불가능해진다.
///
/// ⚠️ 비로그인 사전신청자의 동의는 이 표에 들어가지 않는다 — userId가 필수라서다.
/// 그쪽은 leads의 privacyConsentVersion·marketingConsentVersion이 담당한다.
model Consent {
  id      String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId  String      @map("user_id") @db.Uuid
  type    ConsentType
  /// 동의 = true, 철회 = false
  granted Boolean
  /// 동의한 문안의 버전. 문안이 개정되면 D6에 따라 재동의를 받는다.
  version String?     @db.VarChar(20)

  /// 동의 증빙. 참가신청 동의문은 수집 항목이 이메일 하나보다 넓으므로
  /// leads와 달리 IP 해시를 남길 수 있다(원문은 절대 저장하지 않는다).
  ipHash    String? @map("ip_hash") @db.VarChar(64)
  userAgent String? @map("user_agent")

  /// 참가 시점 동의(null = 계정 동의).
  entryId String? @map("entry_id") @db.Uuid

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// ⚠️ Restrict다. 기본값(SET NULL)이면 참가가 지워질 때 entry_id가 비면서
  /// "참가 시점 동의"가 조용히 "계정 동의"로 바뀐다 — append-only 로그에서
  /// 가장 하면 안 되는 종류의 변조다. 참가는 애초에 지우지 않고 status로 다룬다.
  entry Entry? @relation(fields: [entryId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, type])
  @@map("consents")
}

// ═════════════════════════════════════════════════════════════
// B. 조직 · 팀
// ═════════════════════════════════════════════════════════════

model Organization {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String   @db.VarChar(100)
  type         OrgType?
  contactEmail String?  @map("contact_email") @db.Citext

  seasons Season[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("organizations")
}

/// 팀장 컬럼을 두지 않는다. 팀장의 정본은 team_members.role = leader다.
/// 컬럼과 멤버 행이 둘 다 팀장을 주장하면 어긋났을 때 무엇이 맞는지 알 수 없다.
model Team {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  name String @db.VarChar(60)

  /// 개인 참가도 1인 팀으로 통일한다. 참가 단위가 둘이면 심사·지표·시상이
  /// 전부 두 갈래가 된다. isSolo는 그 사실의 표시일 뿐 구조가 아니다.
  isSolo Boolean @default(false) @map("is_solo")

  members     TeamMember[]
  invitations TeamInvitation[]
  entries     Entry[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("teams")
}

model TeamMember {
  id     String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId String     @map("team_id") @db.Uuid
  userId String     @map("user_id") @db.Uuid
  role   MemberRole @default(member)

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  /// ⚠️ "팀당 팀장 1명"은 Prisma로 표현할 수 없다(부분 유니크 인덱스).
  /// 마이그레이션 SQL에 손으로 넣는다 — 파일 하단 주석 2번.
  @@unique([teamId, userId])
  @@map("team_members")
}

model TeamInvitation {
  id         String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId     String           @map("team_id") @db.Uuid
  inviteCode String           @unique @map("invite_code") @db.VarChar(12)
  email      String?          @db.Citext
  status     InvitationStatus @default(pending)
  expiresAt  DateTime         @map("expires_at") @db.Timestamptz(6)

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("team_invitations")
}

// ═════════════════════════════════════════════════════════════
// C. 시즌 구조
// ═════════════════════════════════════════════════════════════

model Season {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// null = 공개 리그
  organizationId String?     @map("organization_id") @db.Uuid
  title          String      @db.VarChar(100)
  /// URL 조각. GET /api/seasons/:slug
  slug           String      @unique @db.VarChar(60)
  theme          String?     @db.VarChar(100)
  /// 시즌 타임라인(전역 축). season_schedules를 크론이 읽어 전환한다.
  /// 이 칸에 직접 쓰지 않는다.
  phase          SeasonPhase @default(draft)
  /// 시즌 전체 시작일(표시용). 페이즈 전환은 season_schedules가 한다.
  startsAt       DateTime?   @map("starts_at") @db.Timestamptz(6)
  /// 시즌 전체 종료일(표시용). 페이즈 전환은 season_schedules가 한다.
  endsAt         DateTime?   @map("ends_at") @db.Timestamptz(6)
  /// 보증금(원). feature_flags.deposit = false면 무시
  depositAmount  BigInt      @default(30000) @map("deposit_amount")

  /// 시즌별 화면 on/off. 전 화면을 개발하되 플래그로 차단한다(06 §4.4).
  /// off인 라우트는 네비게이션에서 숨기고 직접 접근 시 404를 준다.
  /// 읽는 모든 지점에서 Zod 런타임 검증 필수.
  featureFlags  Json @default("{}") @map("feature_flags")
  /// 채점 가중치·상한·매출모드. 시즌마다 바뀌므로 컬럼이 아니라 JSONB다.
  scoringConfig Json @default("{}") @map("scoring_config")

  organization Organization? @relation(fields: [organizationId], references: [id])

  tracks      Track[]
  stages      Stage[]
  schedules   SeasonSchedule[]
  entries     Entry[]
  userRoles   UserRole[]
  leads       Lead[]
  snapshots   LeaderboardSnapshot[]
  testers     TesterAssignment[]
  awards      Award[]
  creditOffers CreditOffer[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([phase])
  @@map("seasons")
}

/// 시즌 내 참가 분야. 시즌1은 단일 트랙이라 화면에 선택칸을 두지 않고
/// entries.trackId를 null로 남긴다.
model Track {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  seasonId String @map("season_id") @db.Uuid

  name        String  @db.VarChar(60)
  description String?

  season  Season  @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  entries Entry[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([seasonId, name])
  @@map("tracks")
}

/// 제출 단위. 페이즈 전환은 하지 않는다 (ADR-010).
model Stage {
  id       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  seasonId String   @map("season_id") @db.Uuid
  stageKey StageKey @map("stage_key")
  name     String   @db.VarChar(60)
  /// s2(1차 심사)·s5(2차 심사)만 true. 제출 축과 심사 축을 가르는 유일한 칸이다.
  isGate   Boolean  @default(false) @map("is_gate")

  /// 제출 시작. s4 행의 이 값이 주차 기산일이고 거기서 7일씩 끊어 week를 센다.
  opensAt  DateTime? @map("opens_at") @db.Timestamptz(6)
  /// 제출 마감. 이 시각과 season_schedules의 심사 페이즈 시작 시각이 어긋나지 않아야 한다.
  closesAt DateTime? @map("closes_at") @db.Timestamptz(6)

  season Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([seasonId, stageKey])
  @@map("stages")
}

/// ADR-010. 페이즈 전환의 유일한 정본. 크론이 이 표만 읽는다.
model SeasonSchedule {
  id       String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  seasonId String      @map("season_id") @db.Uuid
  /// 이 시각에 seasons.phase를 이 값으로 바꾼다
  phase    SeasonPhase
  /// 전환 예정 시각
  startsAt DateTime    @map("starts_at") @db.Timestamptz(6)

  /// 크론이 실제로 전환한 시각. null = 아직 전환 안 됨.
  /// 중복 실행돼도 null인 행만 처리한다.
  appliedAt DateTime? @map("applied_at") @db.Timestamptz(6)
  /// 운영자가 수동으로 앞당긴 경우의 처리자. 크론 자동이면 null
  appliedBy String?   @map("applied_by") @db.Uuid
  /// 예정 시각과 다르게 전환한 사유
  note      String?

  season Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  actor  User?  @relation(fields: [appliedBy], references: [id])

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([seasonId, phase])
  @@index([seasonId, startsAt])
  @@map("season_schedules")
}

// ═════════════════════════════════════════════════════════════
// D. 참가
// ═════════════════════════════════════════════════════════════

/// 한 팀이 한 시즌에 참가한 기록. 제출·지표·심사·매출·실격이 전부 여기 매달린다.
/// 팀 ≠ 참가다 — 같은 팀이 시즌2에 나가면 참가는 새로 생긴다.
model Entry {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  seasonId String  @map("season_id") @db.Uuid
  teamId   String  @map("team_id") @db.Uuid
  /// 시즌1은 단일 트랙이라 null이다.
  trackId  String? @map("track_id") @db.Uuid

  /// 진도. 심사 결과는 judgments에서 읽는다.
  stage  EntryStage  @default(applied)
  status EntryStatus @default(active)

  /// 탈락팀의 상호 테스터 참여 선택. 심사 결과가 아니라 본인 선택이다.
  isTester Boolean @default(false) @map("is_tester")

  ideaTitle   String  @map("idea_title") @db.VarChar(120)
  ideaSummary String? @map("idea_summary")

  /// 참가자가 신고한 배포 주소(표시용). 측정 대상 주소의 정본은 hostnames다.
  serviceUrl String? @map("service_url")

  /// 과금 유형. R3 심사 트랙을 결정하며 s1 제출 후 변경 불가.
  chargeType ChargeType @default(payment) @map("charge_type")

  /// 문의형의 문의 수단 주소(결제 연동 ③). 팀 주소 경로만 인정한다 —
  /// 문의 도달 이벤트가 팀 주소 경유 접속으로 세어지기 때문이다.
  inquiryUrl String? @map("inquiry_url")

  /// 신청 접수 시각. createdAt과 따로 두는 이유는 운영자가 대신 만든 행이
  /// 있을 수 있어서다 — "언제 행이 생겼나"와 "언제 신청했나"는 다른 질문이다.
  /// 참가 동의 3종을 신청 전에 받으므로, 팀장이 신청을 시작할 때 행을 먼저 만들고
  /// 이 칸을 비워 둔다(2026-08-13 종결본).
  appliedAt DateTime? @map("applied_at") @db.Timestamptz(6)

  season Season @relation(fields: [seasonId], references: [id])
  team   Team   @relation(fields: [teamId], references: [id])
  track  Track? @relation(fields: [trackId], references: [id])

  deposit       Deposit?
  hostname      Hostname?
  integration   PaymentIntegration?
  entryLeads    EntryLead[]
  submissions   Submission[]
  metricDaily   MetricDaily[]
  metricExtra   MetricExtraDaily[]
  metricChannel MetricChannelDaily[]
  metricHourly  MetricHourly[]
  transactions  Transaction[]
  snapshots     LeaderboardSnapshot[]
  abuseFlags    AbuseFlag[]
  violations    ComplianceViolation[]
  sanctions     Sanction[]
  appeals       Appeal[]
  creditClaims  CreditClaim[]
  awards        Award[]
  consents      Consent[]
  testerOf      TesterAssignment[]    @relation("TesterEntry")
  testedBy      TesterAssignment[]    @relation("TargetEntry")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// 한 팀이 같은 시즌에 두 번 신청할 수 없다. 동시 제출의 최종 방어선이다.
  @@unique([seasonId, teamId])
  @@index([seasonId, stage])
  @@index([seasonId, status])
  @@map("entries")
}

model Deposit {
  id      String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entryId String        @unique @map("entry_id") @db.Uuid
  amount  BigInt
  /// 환불은 진도가 completed에 도달한 팀만. 1차 탈락 후 테스터 전환은
  /// 완주가 아니라 forfeited다.
  status  DepositStatus @default(pending)

  pgPaymentKey String?   @map("pg_payment_key") @db.VarChar(255)
  paidAt       DateTime? @map("paid_at") @db.Timestamptz(6)
  refundedAt   DateTime? @map("refunded_at") @db.Timestamptz(6)
  refundReason String?   @map("refund_reason")

  entry Entry @relation(fields: [entryId], references: [id])

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("deposits")
}

/// 측정 대상 주소. 프록시 확정(ADR-006)으로 전 컬럼 유지.
model Hostname {
  id       String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entryId  String       @unique @map("entry_id") @db.Uuid
  /// 팀명.proovit.kr 또는 참가자 도메인
  hostname String       @unique @db.VarChar(255)
  /// 시즌1은 custom 등록을 애플리케이션에서 차단한다 (ADR-007)
  type     HostnameType @default(proovit_sub)

  originUrl    String? @map("origin_url")
  cfHostnameId String? @map("cf_hostname_id") @db.VarChar(255)
  /// 측정 프록시 라우트
  workerRoute  String? @map("worker_route") @db.VarChar(255)

  deployStatus DeployStatus @default(pending) @map("deploy_status")
  sslStatus    SslStatus?   @map("ssl_status")

  ownershipVerifiedAt DateTime? @map("ownership_verified_at") @db.Timestamptz(6)
  /// 참가자가 DNS를 자기 오리진으로 돌려 엣지를 우회한 시각
  bypassDetectedAt    DateTime? @map("bypass_detected_at") @db.Timestamptz(6)
  lastCheckedAt       DateTime? @map("last_checked_at") @db.Timestamptz(6)

  /// 참가자 소유 GA4 속성 ID. 체류 10초 판정을 여기서 병행 확인한다 —
  /// 리버스 프록시는 체류시간을 잴 수 없어서다. 측정 표준이 아니라 보조 확인이다.
  analyticsPropertyId      String?   @map("analytics_property_id") @db.VarChar(40)
  /// 참가자가 운영자에게 조회 권한을 준 시각. null이면 GA4 값을 신뢰하지 않는다.
  analyticsAccessGrantedAt DateTime? @map("analytics_access_granted_at") @db.Timestamptz(6)

  entry Entry @relation(fields: [entryId], references: [id])

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("hostnames")
}

model PaymentIntegration {
  id       String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entryId  String          @unique @map("entry_id") @db.Uuid
  provider PaymentProvider

  merchantId       String? @map("merchant_id") @db.VarChar(120)
  readonlyKeyEnc   String? @map("readonly_key_enc")
  webhookSecretEnc String? @map("webhook_secret_enc")

  status     IntegrationStatus @default(pending)
  verifiedAt DateTime?         @map("verified_at") @db.Timestamptz(6)
  /// 참가자가 「연동 테스트」를 마지막으로 누른 시각(결제 연동 ②의 힌트).
  lastTestedAt DateTime? @map("last_tested_at") @db.Timestamptz(6)

  entry Entry @relation(fields: [entryId], references: [id])

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("payment_integrations")
}

/// ⚠️ 보류 — 점수 축이 유효 방문수로 확정되어 시즌1에서 쓰지 않는다.
model EntryLead {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entryId     String    @map("entry_id") @db.Uuid
  contactHash String    @map("contact_hash") @db.VarChar(64)
  /// null = 미인증 → 점수 미반영
  verifiedAt  DateTime? @map("verified_at") @db.Timestamptz(6)
  sourceHost  String?   @map("source_host") @db.VarChar(255)

  entry Entry @relation(fields: [entryId], references: [id])

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([entryId, contactHash])
  @@index([entryId, verifiedAt])
  @@map("entry_leads")
}

// ═════════════════════════════════════════════════════════════
// E. 제출 · 심사
// ═════════════════════════════════════════════════════════════

model Submission {
  id       String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entryId  String           @map("entry_id") @db.Uuid
  stageKey StageKey         @map("stage_key")
  /// 주차. stages의 s4 행 opens_at부터 7일씩 끊어 센다. 단발 제출 넷은 0.
  week     Int              @default(0) @db.SmallInt
  status   SubmissionStatus @default(draft)
  payload  Json             @default("{}")

  /// 피칭자료·로고·데모영상 + 지표 증빙. R2 저장.
  /// ⚠️ 지표의 근거로 쓰지 않는다 — 서버측 집계가 유일한 근거다(PLN5 §8).
  evidenceUrls String[] @map("evidence_urls")

  /// 보완 재제출 마감(원 마감 +48시간). 팀별로 달라 stages.closes_at과 별개.
  revisionDueAt DateTime? @map("revision_due_at") @db.Timestamptz(6)

  /// 제출을 누른 사람. 팀장만 누를 수 있으나 시즌 중 팀장이 바뀔 수 있어
  /// 그 시각의 주체를 남긴다 — 마감 직전 재제출 분쟁의 유일한 근거다.
  submittedBy String?   @map("submitted_by") @db.Uuid
  submittedAt DateTime? @map("submitted_at") @db.Timestamptz(6)

  entry     Entry      @relation(fields: [entryId], references: [id])
  submitter User?      @relation(fields: [submittedBy], references: [id])
  judgments Judgment[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([entryId, stageKey, week])
  @@map("submissions")
}

model Judgment {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  submissionId String         @map("submission_id") @db.Uuid
  result       JudgmentResult
  autoScore    Decimal?       @map("auto_score") @db.Decimal(10, 4)

  /// 2차는 전면 공개, 1차는 결과와 항목별 근거만 공개하고 배점 숫자는 비공개.
  /// 컬럼은 두 경우 다 값을 갖고, 응답 단계에서 stage_key로 갈라 마스킹한다.
  scoreBreakdown Json?   @map("score_breakdown")
  /// 채점식 버전. 규칙이 바뀌어도 과거 판정을 재현한다.
  formulaVersion String? @map("formula_version") @db.VarChar(20)
  /// 참고자료. 점수 미반영(주관심사 배제 원칙).
  aiReport       Json?   @map("ai_report")
  feedback       String?

  judgedBy String?  @map("judged_by") @db.Uuid
  judgedAt DateTime @default(now()) @map("judged_at") @db.Timestamptz(6)

  submission Submission @relation(fields: [submissionId], references: [id])
  judge      User?      @relation(fields: [judgedBy], references: [id])

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("judgments")
}

/// ⚠️ 제안 단계(2026-08-13) — 수연·윤서 확인 전.
/// 제11조(이의신청): 판정 통지 후 5영업일 이내 신청, 운영자는 5영업일 내 서면 답변,
/// 산정 오류 확인 시 정정. "제재 결정에도 본 조를 준용함"(제11조③)이라
/// judgments와 sanctions 양쪽이 이 표 하나를 공유한다.
/// sanctions.appeal_text는 별개다 — 그건 제재 "적용 전" 소명(제16조①)이고
/// 이 표는 판정·제재 "결정 후" 정식 이의신청이다.
model Appeal {
  id         String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entryId    String @map("entry_id") @db.Uuid
  /// judgment / sanction / abuse_flag
  targetType String @map("target_type") @db.VarChar(20)
  targetId   String @map("target_id") @db.Uuid
  reasonText String @map("reason_text")
  /// 증빙 파일의 키 — 시안 「증빙 첨부」. submissions.evidence_urls와 같은 꼴
  evidenceUrls String[] @default([]) @map("evidence_urls")

  submittedAt   DateTime  @default(now()) @map("submitted_at") @db.Timestamptz(6)
  /// 접수 시각 + 5영업일. 영업일 계산은 애플리케이션이 한다.
  responseDueAt DateTime? @map("response_due_at") @db.Timestamptz(6)
  responseText  String?   @map("response_text")
  respondedAt   DateTime? @map("responded_at") @db.Timestamptz(6)
  respondedBy   String?   @map("responded_by") @db.Uuid
  /// 산정 오류가 확인돼 원 판정·제재가 정정됐는지(제11조③)
  corrected     Boolean   @default(false)

  entry     Entry @relation(fields: [entryId], references: [id])
  responder User? @relation(fields: [respondedBy], references: [id])

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([targetType, targetId])
  @@index([entryId])
  @@map("appeals")
}

// ═════════════════════════════════════════════════════════════
// F. 지표
// ═════════════════════════════════════════════════════════════

model MetricDefinition {
  id   String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// visitors / signups / retention / channels
  key  String  @unique @db.VarChar(40)
  name String  @db.VarChar(60)
  unit String? @db.VarChar(20)

  /// column이면 metric_daily의 고정 칸에, extra면 metric_extra_daily에 저장한다.
  /// 지표를 늘릴 때 컬럼이 아니라 정의 행만 추가하면 되는 구조다.
  storage    MetricStorage @default(extra)
  /// storage가 column일 때 대응하는 metric_daily 컬럼명. extra면 비운다.
  columnName String?       @map("column_name") @db.VarChar(40)
  /// 행 삭제가 아닌 on/off
  isActive   Boolean       @default(true) @map("is_active")

  extraDaily MetricExtraDaily[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("metric_definitions")
}

model MetricDaily {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  entryId    String   @map("entry_id") @db.Uuid
  metricDate DateTime @map("metric_date") @db.Date

  rawVisitors   Int    @default(0) @map("raw_visitors")
  validVisitors Int    @default(0) @map("valid_visitors")
  pageviews     Int    @default(0)
  botFiltered   Int    @default(0) @map("bot_filtered")
  signups       Int    @default(0)
  revenue       BigInt @default(0)

  source MetricSource @default(edge)

  /// 무효율 검수(1 − 유효 방문/총 세션 > 0.6)의 분모
  sessions     Int @default(0)
  /// 일별 유효 방문이 기간 중위값의 20배를 넘을 때 잘라낸 수
  spikeTrimmed Int @default(0) @map("spike_trimmed")

  /// 엣지가 이 집계본을 만든 배치 시각. 엣지가 값과 함께 보낸다.
  /// upsert는 batch_at이 더 최신일 때만 덮어쓴다. manual 행은 null.
  /// ⚠️ CHECK 제약은 Prisma가 표현하지 못한다. 파일 하단 주석 1번.
  batchAt DateTime? @map("batch_at") @db.Timestamptz(6)

  /// abuse_flags가 걸린 건만 채운다. 그 외 행에서는 의미 없음.
  manualReviewPassed Boolean @default(true) @map("manual_review_passed")
  reviewedBy         String? @map("reviewed_by") @db.Uuid

  entry    Entry @relation(fields: [entryId], references: [id])
  reviewer User? @relation(fields: [reviewedBy], references: [id])

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([entryId, metricDate])
  @@map("metric_daily")
}

/// 채점 축이 아닌 참고 지표. 지표를 늘릴 때 컬럼이 아니라 행이 는다.
model MetricExtraDaily {
  id           String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  entryId      String   @map("entry_id") @db.Uuid
  metricDate   DateTime @map("metric_date") @db.Date
  definitionId String   @map("definition_id") @db.Uuid

  /// 개수·금액·비율을 한 칸에 담아야 해서 정수형을 쓰지 않는다.
  value  Decimal      @default(0) @db.Decimal(20, 4)
  source MetricSource @default(edge)

  /// upsert는 이 값이 더 최신일 때만 덮어쓴다.
  /// metric_daily와 달리 CHECK 제약을 걸지 않는다 — 채점에 들어가지 않는 값이다.
  batchAt DateTime? @map("batch_at") @db.Timestamptz(6)

  entry      Entry            @relation(fields: [entryId], references: [id])
  definition MetricDefinition @relation(fields: [definitionId], references: [id])

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([entryId, metricDate, definitionId])
  @@index([definitionId])
  @@map("metric_extra_daily")
}

/// T3 유입 채널 다양성의 원자료. 채널별 비중 제곱합으로 유효 채널 수를 낸다.
/// 날짜별 합계 한 줄로는 채널별 비중을 복원할 수 없어 따로 둔다.
model MetricChannelDaily {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  entryId    String   @map("entry_id") @db.Uuid
  metricDate DateTime @map("metric_date") @db.Date
  /// direct는 통째로 하나로 세고, UTM 태깅분은 각각 하나.
  /// 참가자가 UTM을 직접 정하므로 ENUM으로 닫지 않는다.
  channel    String   @db.VarChar(60)
  visitors   Int      @default(0)

  entry Entry @relation(fields: [entryId], references: [id])

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([entryId, metricDate, channel])
  @@map("metric_channel_daily")
}

model MetricHourly {
  id       String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  entryId  String   @map("entry_id") @db.Uuid
  bucketAt DateTime @map("bucket_at") @db.Timestamptz(6)

  validVisitors Int    @default(0) @map("valid_visitors")
  pageviews     Int    @default(0)
  revenue       BigInt @default(0)

  /// 엣지가 이 집계본을 만든 배치 시각. upsert는 이 값이 더 최신일 때만 덮어쓴다.
  batchAt DateTime @map("batch_at") @db.Timestamptz(6)

  entry Entry @relation(fields: [entryId], references: [id])

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([entryId, bucketAt])
  @@map("metric_hourly")
}

model Transaction {
  id      String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  entryId String @map("entry_id") @db.Uuid

  /// 멱등키(중복 웹훅 방지)
  providerTxId String  @unique @map("provider_tx_id") @db.VarChar(255)
  /// 환불·취소가 어느 결제에 대한 것인지(순매출 계산)
  relatedTxId  String? @map("related_tx_id") @db.VarChar(255)

  amount     BigInt
  status     TransactionStatus
  paidAt     DateTime          @map("paid_at") @db.Timestamptz(6)
  rawPayload Json              @map("raw_payload")

  /// 결제자 식별 해시. 유효 결제자 수 c, L3 "서로 다른 3인", L4 재결제 판정의
  /// 유일한 근거. null이면 결제자 수 집계에서 제외.
  payerHash String? @map("payer_hash") @db.VarChar(64)

  /// 순매출·전환율 계산에서 빠짐
  isExcluded      Boolean          @default(false) @map("is_excluded")
  exclusionReason ExclusionReason? @map("exclusion_reason")
  /// 수동 제외한 운영자. 자동 판정이면 null
  excludedBy      String?          @map("excluded_by") @db.Uuid
  excludedAt      DateTime?        @map("excluded_at") @db.Timestamptz(6)

  entry    Entry @relation(fields: [entryId], references: [id])
  excluder User? @relation(fields: [excludedBy], references: [id])

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([entryId, paidAt])
  @@index([entryId, payerHash])
  @@map("transactions")
}

model LeaderboardSnapshot {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  seasonId     String   @map("season_id") @db.Uuid
  entryId      String   @map("entry_id") @db.Uuid
  snapshotDate DateTime @map("snapshot_date") @db.Date

  /// 실격 여부와 무관하게 전 팀 기준으로 저장한다(06 §6.3).
  /// 공개 응답에서 status != active인 행을 빼고 번호를 다시 매긴다 —
  /// 저장은 전체 기준, 노출은 생존 팀 기준으로 갈라둔 것이다.
  rank  Int
  score Decimal @db.Decimal(12, 4)

  validVisitorsTotal Int     @default(0) @map("valid_visitors_total")
  revenueTotal       BigInt  @default(0) @map("revenue_total")
  isFinal            Boolean @default(false) @map("is_final")

  /// R3 수익화 단계(L0~L4 또는 L0'~L4')와 판정 근거도 여기에 담는다
  scoreBreakdown  Json    @default("{}") @map("score_breakdown")
  /// 채점식·앵커 버전. 기준이 바뀌어도 과거 순위를 그대로 재현
  formulaVersion  String? @map("formula_version") @db.VarChar(20)
  /// 축 하한(T>=20 그리고 R>=10) 충족 여부.
  /// false면 종합 시상에서 제외하고 순위표에는 표시한다.
  isAwardEligible Boolean @default(true) @map("is_award_eligible")

  season Season @relation(fields: [seasonId], references: [id])
  entry  Entry  @relation(fields: [entryId], references: [id])

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  /// 마지막으로 롤업이 이 행을 고친 시각. 하루 한 행을 15분마다 덮어쓰므로
  /// snapshot_date(날짜)만으로는 "N분 전 갱신"을 말할 수 없다.
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([seasonId, entryId, snapshotDate])
  @@index([seasonId, snapshotDate, rank])
  @@map("leaderboard_snapshots")
}

// ═════════════════════════════════════════════════════════════
// G. 상호 테스터
// ═════════════════════════════════════════════════════════════

model TesterAssignment {
  id            String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  seasonId      String @map("season_id") @db.Uuid
  week          Int    @db.SmallInt
  testerEntryId String @map("tester_entry_id") @db.Uuid
  targetEntryId String @map("target_entry_id") @db.Uuid

  /// 배정 시 생성. 이 토큰이 붙은 방문만 상대 팀 지표에서 제외한다.
  trackingToken String    @unique @map("tracking_token") @db.VarChar(32)
  /// 토큰으로 실제 접속한 시각. 의무 이행 확인 보조.
  visitedAt     DateTime? @map("visited_at") @db.Timestamptz(6)

  season      Season          @relation(fields: [seasonId], references: [id])
  testerEntry Entry           @relation("TesterEntry", fields: [testerEntryId], references: [id])
  targetEntry Entry           @relation("TargetEntry", fields: [targetEntryId], references: [id])
  feedback    TesterFeedback?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([week, testerEntryId, targetEntryId])
  @@map("tester_assignments")
}

model TesterFeedback {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assignmentId String @unique @map("assignment_id") @db.Uuid
  content      String
  /// 1~5
  rating       Int?   @db.SmallInt

  submittedAt DateTime @default(now()) @map("submitted_at") @db.Timestamptz(6)

  assignment TesterAssignment @relation(fields: [assignmentId], references: [id])

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("tester_feedbacks")
}

// ═════════════════════════════════════════════════════════════
// H. 혜택 · 스폰서
// ═════════════════════════════════════════════════════════════

/// 스폰서. 크레딧을 만들고 발급하는 주체다.
/// PROOVIT은 코드를 만들지 않고 전달과 확인만 한다(13 크레딧 센터 설계서 2장).
model Sponsor {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String  @db.VarChar(80)
  /// 카드에 붙일 로고. 광고용역 계약 범위 안에서만 노출한다(13 설계서 8장)
  logoUrl     String? @map("logo_url")
  benefitDesc String? @map("benefit_desc")
  websiteUrl  String? @map("website_url")
  /// 카드의 워드마크 칸에 찍는 글자 하나(시안 「R」·「▲」). 없으면 이름 첫 글자
  mark        String? @db.VarChar(4)

  offers CreditOffer[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("sponsors")
}

/// 혜택 카드 한 장. 시즌 × 종류로 하나다(13 설계서 3장 표).
///
/// 카드가 팀별 발급(credit_claims)과 갈라져 있는 이유는 「협의 중」 때문이다.
/// 스폰서가 안 붙어도 카드는 서 있고 폴백(0원 스타트 스택)을 보여준다 —
/// 제휴 0건이어도 혜택 탭은 연다는 것이 13 설계서 2장의 전제다.
model CreditOffer {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  seasonId  String  @map("season_id") @db.Uuid
  /// 협의 중이면 null이다. 그때 화면은 스폰서명 대신 「스폰서 미정」을 쓴다
  sponsorId String? @map("sponsor_id") @db.Uuid

  kind   CreditKind
  status CreditOfferStatus @default(negotiating)

  /// 이 사건이 일어나면 팀의 발급 상태가 「잠금」에서 「발급 가능」으로 간다.
  /// 참가 등록만으로는 아무것도 열리지 않는다 — 파밍 차단(13 설계서 2장)
  unlockEvent    CreditUnlockEvent @map("unlock_event")
  deliveryMethod CreditDelivery    @default(manual) @map("delivery_method")

  /// 코드 배포 예정일. C1은 빌드 스테이지 개시일이다 —
  /// 크레딧 유효기간이 지급 시점부터 도므로 제출 즉시 주면 참가자가 손해를 본다
  /// (광고용역 계약서 별지 2 기산점).
  releaseDate DateTime? @map("release_date") @db.Timestamptz(6)
  validUntil  DateTime? @map("valid_until") @db.Timestamptz(6)

  /// INVITE_LINK일 때 쓴다. CODE_POOL이면 credit_codes를 본다
  inviteUrl String? @map("invite_url")
  /// 「적용 방법」 링크(시안 `.lnk`). 없으면 링크를 안 그린다
  howtoUrl String? @map("howto_url")
  /// 발송 줄에 붙는 적용 안내 한 토막(시안 「Replit 계정의 Billing에서 Redeem」)
  redeemNote String? @map("redeem_note") @db.VarChar(120)

  /// 카드 본문과 예상 가치 표기("$75 상당"). 금액이 아니라 문자열인 이유는
  /// 통화·표기가 스폰서마다 다르고 계산에 쓰지 않기 때문이다
  description String?
  value       String? @db.VarChar(60)

  /// 0원 스타트 스택. 스폰서가 없을 때 같은 루트를 무료 티어로 가는 안내다.
  /// 노션 링크 하나 + 항목 목록(JSONB, [{name, note}])
  fallbackUrl   String? @map("fallback_url")
  fallbackItems Json    @default("[]") @map("fallback_items")

  season  Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  sponsor Sponsor? @relation(fields: [sponsorId], references: [id])

  codes  CreditCode[]
  claims CreditClaim[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// 시즌 안에서 카드 종류는 한 장뿐이다
  @@unique([seasonId, kind])
  @@index([seasonId, status])
  @@map("credit_offers")
}

/// 코드 풀 한 줄. **스폰서가 만들어 준 것을 올려둔 것**이라 우리가 생성하지 않는다.
/// 소비는 되돌리지 않는다(13 설계서 4장 전이 규칙).
model CreditCode {
  id      String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  offerId String @map("offer_id") @db.Uuid

  code   String       @unique @db.VarChar(120)
  status CreditStatus @default(issued)

  offer CreditOffer  @relation(fields: [offerId], references: [id], onDelete: Cascade)
  claim CreditClaim?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([offerId, status])
  @@map("credit_codes")
}

/// 팀 하나가 카드 하나에 대해 갖는 상태. 발급 단위는 **팀**이다 —
/// 팀원 수와 무관하게 카드당 1건(13 설계서 2장 「팀당 1회」).
///
/// 「잠금」은 행이 없는 것으로 표현한다. 언락 이벤트가 일어나야 행이 생긴다.
model CreditClaim {
  id      String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  offerId String @map("offer_id") @db.Uuid
  entryId String @map("entry_id") @db.Uuid

  status CreditClaimStatus @default(available)

  unlockedAt  DateTime  @default(now()) @map("unlocked_at") @db.Timestamptz(6)
  claimedAt   DateTime? @map("claimed_at") @db.Timestamptz(6)
  deliveredAt DateTime? @map("delivered_at") @db.Timestamptz(6)
  confirmedAt DateTime? @map("confirmed_at") @db.Timestamptz(6)

  /// 소비한 코드. CODE_POOL일 때만 붙는다. 링크형·수동형은 null이다
  creditCodeId String? @unique @map("credit_code_id") @db.Uuid
  deliveredVia CreditDeliveredVia? @map("delivered_via")

  offer      CreditOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  entry      Entry       @relation(fields: [entryId], references: [id], onDelete: Cascade)
  creditCode CreditCode? @relation(fields: [creditCodeId], references: [id])

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// 팀당 1회. 이중 발급의 최종 방어선이다
  @@unique([offerId, entryId])
  @@index([entryId])
  @@map("credit_claims")
}

// ═════════════════════════════════════════════════════════════
// I. 운영
// ═════════════════════════════════════════════════════════════

/// 사전신청 이메일 = KPI#1의 원천.
/// 수명이 '영구'인 이유: 시즌1 미참가자가 시즌2의 모집 풀이다.
model Lead {
  id    String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email String @db.Citext

  /// 어느 시즌을 보고 신청했는지.
  ///
  /// nullable로 두지 않는 이유: Postgres는 UNIQUE에서 NULL을 서로 다른 값으로 취급한다.
  /// season_id가 NULL이면 아래 @@unique가 무력화돼 같은 이메일이 무제한 쌓이고,
  /// 그 숫자가 곧 KPI#1(실측 신청자 수)이자 지원사업 제출 수치라 부풀려지면 안 된다.
  seasonId String @map("season_id") @db.Uuid
  season   Season @relation(fields: [seasonId], references: [id], onDelete: Restrict)

  /// 유입 채널 분석용. 랜딩의 쿼리스트링에서 수집한다.
  sourceChannel String? @map("source_channel") @db.VarChar(60)
  utmSource     String? @map("utm_source") @db.VarChar(120)
  utmMedium     String? @map("utm_medium") @db.VarChar(120)
  utmCampaign   String? @map("utm_campaign") @db.VarChar(120)
  /// Referer 헤더. UTM 없는 자연 유입의 유일한 근거.
  referrer      String? @db.Text

  /// 모집 오픈 시 1순위 알림 대상. 발송 후 시각을 남긴다.
  notifiedAt DateTime? @map("notified_at") @db.Timestamptz(6)

  status LeadStatus @default(new)

  /**
   * 동의 로그 — 운영규칙서 D8이 "동의 일시·문안 버전·식별값"의 서버 저장을 요구한다.
   * 동의 사실의 입증 책임이 회사에 있으므로 문안이 개정돼도 "그때 무엇에 동의했는지"가
   * 남아야 한다. 그래서 불리언이 아니라 버전 문자열을 박는다.
   * 만 14세 확인은 문안 A 안에 든 항목이라 별도 컬럼을 두지 않는다 —
   * 어느 문안에 동의했는지가 남으면 그 안의 조항도 함께 특정된다.
   * 식별값으로 IP를 쓰지 않는 이유: 문안 A의 수집 항목이 이메일 하나뿐이라
   * IP를 저장하면 문안에 없는 항목을 수집하게 되어 최소수집 위반이 된다.
   */

  /// 개인정보 수집·이용 필수 동의 시각. 이 값 없이 행을 만들지 않는다.
  privacyConsentAt      DateTime @map("privacy_consent_at") @db.Timestamptz(6)
  /// 동의한 「개인정보 수집·이용 동의문」 문안 A의 버전.
  privacyConsentVersion String?  @map("privacy_consent_version") @db.VarChar(20)

  /// 마케팅 수신 동의(선택). 기본 해제이며 미동의로도 접수된다(D5).
  marketingOptIn          Boolean   @default(false) @map("marketing_opt_in")
  /// 동의한 마케팅 수신 문안의 버전. marketingOptIn이 참일 때만 값이 있다.
  marketingConsentVersion String?   @map("marketing_consent_version") @db.VarChar(20)
  /// 수신거부 시각. null이면 거부 안 함. 철회의 정본 경로는 메일 하단 수신거부 링크(M5)다.
  unsubscribedAt          DateTime? @map("unsubscribed_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// 같은 시즌에 같은 이메일이 중복 신청되지 않도록 한다.
  @@unique([seasonId, email])
  @@index([createdAt])
  @@map("leads")
}

model Notification {
  id      String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId  String  @map("user_id") @db.Uuid
  /// deadline / gate_result / appeal 등. 값 목록은 코드 상수로 관리.
  type    String  @db.VarChar(40)
  title   String
  body    String?
  linkUrl String? @map("link_url")

  /// 통지 정본은 email·inapp이다. alimtalk은 users.phone이 있을 때만 보조로 얹는다.
  channel NotifChannel @default(inapp)

  sentAt         DateTime?       @map("sent_at") @db.Timestamptz(6)
  /// 도달 결과. 근거로 삼는 채널은 전원에게 가는 email.
  deliveryStatus DeliveryStatus? @map("delivery_status")
  /// null = 미읽음
  readAt         DateTime?       @map("read_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, readAt])
  @@map("notifications")
}

model AbuseFlag {
  id       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entryId  String   @map("entry_id") @db.Uuid
  ipHash   String?  @map("ip_hash") @db.VarChar(64)
  /// CF 봇 스코어
  botScore Decimal? @map("bot_score") @db.Decimal(5, 2)
  reason   String?  @db.VarChar(120)

  /// 의심 유형 — 제15조 금지행위 7종 중 어느 것인가. 제재의 근거(`sanctions.reason`)가 된다.
  /// 지표 검토 이관처럼 유형을 모르는 채 올라온 플래그는 비어 있다.
  kind     SanctionReason?
  severity AbuseSeverity?
  /// 증거 요약 한 줄(「03:12~04:40, 214건, UA 단일」). 운영 표에 그대로 선다.
  evidence String?        @db.VarChar(200)

  status           AbuseStatus @default(flagged)
  adjustedVisitors Int?        @map("adjusted_visitors")

  /// 참가자 소명 — 실격이 곧 분쟁이므로 창구가 반드시 있어야 한다.
  appealText String?   @map("appeal_text")
  appealedAt DateTime? @map("appealed_at") @db.Timestamptz(6)

  /// 운영자 처리 사유(필수 기록)
  resolutionNote String? @map("resolution_note")
  reviewedBy     String? @map("reviewed_by") @db.Uuid

  entry    Entry @relation(fields: [entryId], references: [id])
  reviewer User? @relation(fields: [reviewedBy], references: [id])

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([entryId, status])
  @@map("abuse_flags")
}

/// ⚠️ ADR-008(심사 구조)에 종속. report_late의 정의는 8/17 확인 대기.
model ComplianceViolation {
  id      String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entryId String        @map("entry_id") @db.Uuid
  week    Int           @db.SmallInt
  /// 실격 기간에 못 낸 제출은 위반으로 세지 않는다. 실격 구간은 audit_logs로 판정한다.
  type    ViolationType
  note    String?

  createdBy String? @map("created_by") @db.Uuid

  entry   Entry @relation(fields: [entryId], references: [id])
  creator User? @relation(fields: [createdBy], references: [id])

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([entryId, week, type])
  @@index([entryId, type])
  @@map("compliance_violations")
}

/// ⚠️ 제안 단계(2026-08-13) — 수연(구현 가능성)·윤서(제16조 해석) 확인 전.
/// 제16조 제재 4단계를 이 표 하나로 받는다. 비례 적용이라 warning부터 순서대로
/// 안 거치고 바로 높은 단계로 갈 수 있다.
/// week_invalidated는 metric_daily에 캐시 컬럼을 두지 않고 채점 시점에 조인해서 뺀다.
model Sanction {
  id      String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entryId String         @map("entry_id") @db.Uuid
  /// 제16조1항 4단계
  stage   SanctionStage
  /// 제15조 금지행위 7종 중 근거
  reason  SanctionReason
  /// 위반 사실 서술(필수 기록). audit_logs.reason과 같은 이유로 meta에 안 넣고 컬럼으로 강제.
  detail  String

  /// 이 제재를 촉발한 근거 종류. abuse_flag / compliance_violation / manual
  sourceType String? @map("source_type") @db.VarChar(20)
  sourceId   String? @map("source_id") @db.Uuid

  /// stage=week_invalidated일 때만. compliance_violations.week와 같은 타입.
  week Int? @db.SmallInt

  /// stage=warning의 24시간 시정 기한
  correctionDeadline DateTime? @map("correction_deadline") @db.Timestamptz(6)
  /// 적용 전 소명 기한(제16조1항). 이 시각까지 소명 없으면 적용한다.
  /// appeals 표와 다른 절차다 — 그쪽은 결정 "후" 정식 이의신청이다.
  appealDeadlineAt   DateTime? @map("appeal_deadline_at") @db.Timestamptz(6)
  appealText         String?   @map("appeal_text")
  appealedAt         DateTime? @map("appealed_at") @db.Timestamptz(6)

  status SanctionStatus @default(pending)

  /// stage=award_revoked일 때만. 제16조2항 취소·환수 대상 시상.
  awardId        String? @map("award_id") @db.Uuid
  /// 환수 금액(원). null이면 시상 취소만이고 환수는 없음.
  clawbackAmount BigInt? @map("clawback_amount")

  decidedBy String?   @map("decided_by") @db.Uuid
  appliedAt DateTime? @map("applied_at") @db.Timestamptz(6)

  entry   Entry  @relation(fields: [entryId], references: [id])
  award   Award? @relation(fields: [awardId], references: [id])
  decider User?  @relation(fields: [decidedBy], references: [id])

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([entryId, stage])
  @@map("sanctions")
}

model IpBlocklist {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ipHash    String  @unique @map("ip_hash") @db.VarChar(64)
  reason    String? @db.VarChar(120)
  createdBy String? @map("created_by") @db.Uuid

  creator User? @relation(fields: [createdBy], references: [id])

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("ip_blocklist")
}

model Award {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  seasonId String @map("season_id") @db.Uuid
  entryId  String @map("entry_id") @db.Uuid

  /// 종합 시상에만 사용하고 부문상은 null
  rank      Int?
  prizeType PrizeType? @map("prize_type")
  prizeDesc String?    @map("prize_desc")
  amount    BigInt?
  awardType AwardType  @default(overall) @map("award_type")
  awardedAt DateTime?  @map("awarded_at") @db.Timestamptz(6)

  season    Season     @relation(fields: [seasonId], references: [id])
  entry     Entry      @relation(fields: [entryId], references: [id])
  sanctions Sanction[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("awards")
}

model AuditLog {
  id         BigInt  @id @default(autoincrement())
  actorId    String? @map("actor_id") @db.Uuid
  /// judge_pass / disqualify / refund 등
  action     String  @db.VarChar(60)
  targetType String  @map("target_type") @db.VarChar(40)
  targetId   String? @map("target_id") @db.Uuid
  meta       Json?
  /// 실격·오버라이드 사유 필수. meta JSONB에 넣으면 강제가 안 된다.
  reason     String

  actor User? @relation(fields: [actorId], references: [id])

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([targetType, targetId])
  @@map("audit_logs")
}

// ═════════════════════════════════════════════════════════════
// ⚠️ Prisma가 표현하지 못하는 제약 2건 — 마이그레이션 SQL에 손으로 넣는다.
//    migrate reset이나 새 환경 구축에서도 따라오게 하기 위해서다.
//
// 1) metric_daily.batch_at 조건부 필수
//    ALTER TABLE metric_daily
//      ADD CONSTRAINT metric_daily_batch_at_required
//      CHECK (source <> 'edge' OR batch_at IS NOT NULL);
//    → 없으면 엣지가 배치 시각을 안 보내도 통과해서 역행 방어가 무력화된다.
//
// 2) team_members 팀당 leader 1명
//    CREATE UNIQUE INDEX team_members_one_leader
//      ON team_members (team_id) WHERE role = 'leader';
//    → 없으면 한 팀에 팀장이 둘 생길 수 있다.
//
// uuidv7()은 확장이 필요 없다 — 운영 Neon이 PostgreSQL 18.4이고 18부터 코어 함수다.
// (확장이 주는 이름은 uuid_generate_v7(), 코어가 주는 이름은 uuidv7()로 다를 뿐이다)
// ═════════════════════════════════════════════════════════════
