enum CreditStatus {
  issued
  claimed
  expired
}

/// 혜택 카드 4종(13 크레딧 센터 설계서 3장).
/// c4는 상금 규정이 적용되는 부상이라 클레임 흐름을 타지 않는다.
enum CreditKind {
