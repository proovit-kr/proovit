  related_party
  test
  under_minimum
}

/// 마감 통지 분쟁의 근거는 delivered와 bounced를 가르는 것이다.
enum DeliveryStatus {
  queued
  sent
  delivered
  bounced
  failed
}

enum ViolationType {
  report_late
  evidence_ignored
  tester_skip
}

enum PrizeType {
  cash
  credit
  incubation
}

enum SanctionStage {
  warning
  week_invalidated
  disqualified
  award_revoked
}

/// 제15조 금지행위 7종. 규정 개정에 30일 예고가 걸려 운영 중 임의로 안 늘어난다고 보고 ENUM으로 닫음.
enum SanctionReason {
  bot_traffic
  multi_account
  paid_signup
  evidence_forged
  undisclosed_ad
  attack_or_spam
  false_representation
}

/// 어뷰징 플래그의 심각도 — 운영 어뷰징 표(시안 `#scr-adm-abuse`)의 높음·중간·낮음
enum AbuseSeverity {
  high
  medium
  low
}

enum SanctionStatus {
  pending
  applied
  withdrawn
}

/// column = metric_daily의 고정 칸, extra = metric_extra_daily
enum MetricStorage {
  column
  extra
}

/// edge = 측정 프록시 집계본, manual = 운영자 보정 (ADR-006 리버스 프록시 확정).
/// ga4는 체류시간 보조 확인 전용이다 — 측정 표준이 아니다.
enum MetricSource {
  edge
  manual
  ga4
}

enum JudgmentResult {
