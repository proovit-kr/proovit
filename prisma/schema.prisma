  expired
  revoked
}

/// 시즌의 제출 단계(PLN6, 2026-08-13). 게이트 여부는 stages.is_gate가 따로 가진다 —
/// s2·s5만 게이트이고 s1·s3·s4는 제출만 받는다. 제출 축과 심사 축을 한 값에 겸하지 않는다.
enum StageKey {
