// PROOVIT — Prisma schema
//
// 이 파일이 DB 명세의 소스 오브 트루스다 (Notion 03 ERD/DB 설계서 명시).
// ERD 그림은 prisma-erd-generator로 자동 생성한다.
//
// 근거: 노션 「작업」 DB의 schema.prisma 종결본(2026-08-13, 42테이블/33ENUM) ·
//       PLN6 필드 정의서 v0.1(2026-08-13) · PLN5 API 명세서 v0.2(2026-08-13) ·
//       06 ARCHITECTURE §4 상태 설계
//
// 2026-08-13 DEV8 이식. 정본 규칙 = 레포와 노션 중 최신 쪽(이번엔 노션).
// 단 generator·datasource 블록은 레포가 정본이다 — 노션본은 Prisma 6 문법이다.
//
// 노션본을 그대로 따르지 않은 지점은 한 곳뿐이다.
//   VerificationToken — 노션본에 없다. 자체 회원가입용이 아니라 Auth.js 어댑터가
//   구현해야 하는 인터페이스(createVerificationToken/useVerificationToken)의
//   저장소라, 지우면 src/lib/auth-adapter.ts가 컴파일되지 않는다.
//
// 규칙: 시즌 종속 테이블은 예외 없이 seasonId를 갖는다. 시즌2를 열었을 때
// 시즌1 데이터가 섞이면 리더보드와 심사가 오염되고, 되돌리기가 가장 어렵다.

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  // Prisma 7부터 url·directUrl은 이 파일에 둘 수 없다. prisma.config.ts가 정본이다.
  // 런타임은 pooled 주소(DATABASE_URL), 마이그레이션은 direct 주소(DIRECT_URL)를 쓴다.
  // citext = 대소문자 구분 없는 텍스트(이메일).
  // pgcrypto = gen_random_uuid(). 선언하지 않으면 마이그레이션이 CREATE EXTENSION을
  // 빠뜨려 새 DB에서 실패한다.
  extensions = [citext, pgcrypto]
}

// ═════════════════════════════════════════════════════════════
// J. ENUM (33)
//
// ⚠️ 이전 레포본은 SeasonPhase만 대문자 + @@map("season_phase")였다. 종결본 표기
// (PascalCase 타입명 · 소문자 값 · @@map 없음)로 통일했다. 8/17 안건이던
// "ENUM 타입명 규칙"이 이걸로 닫힌다.
// ═════════════════════════════════════════════════════════════

/// 시즌 타임라인. 전환 주체는 season_schedules다 (ADR-010).
/// pre_apply = 사전신청만 받는 구간. 이 값이 생기면서 랜딩 CTA를 recruit_start_at
/// 비교로 우회하던 것이 사라진다 — phase 하나로 갈린다.
///
/// 2026-08-14: 10값 → 6값. `w1_demand · gate1_review · w2_build · race · gate2_review`
/// 다섯이 `racing` 하나로 통합됐다(동혁 종결본 수정, 8/13 스크럼 회신).
/// 그 다섯은 4주·게이트 2회 시절의 값이라 5스테이지 모델과 맞지 않았다.
/// **스테이지별 제출 창은 stages.opens_at/closes_at이 단독 근거이고, 게이트 심사
/// 대기는 phase가 아니라 entry.stage(s2·s5)로 판정한다** — access-policy.ts 참조.
enum SeasonPhase {
  draft
  pre_apply
  recruiting
  racing
  awarded
  archived
}

/// 팀의 진도만 나타낸다. 통과·보완·탈락은 judgments가 정본이고 여기 섞지 않는다.
/// 값이 s3이면 s2 게이트를 통과했다는 뜻이다(전진 자체가 통과의 근거).
enum EntryStage {
  applied
  s1
  s2
  s3
  s4
  s5
  completed
}

/// 생존 여부 — stage와 직교. 실격돼도 진행도는 보존된다.
/// eliminated = 게이트 미통과, disqualified = 규칙 위반 실격
enum EntryStatus {
  active
  eliminated
  disqualified
  withdrawn
}

/// 시즌1은 ADR-007로 custom 등록을 애플리케이션에서 차단한다. 값은 시즌2 대비 유지.
enum HostnameType {
  proovit_sub
  custom
}

/// 동의 종류. 하나의 append-only 로그에 다 담기므로 종류로 구분한다.
enum ConsentType {
  terms
  privacy
  marketing
  /// 지표 공개 동의 — 리더보드에 우리 팀 숫자가 뜨는 것에 대한 동의
  metrics_public
  /// 증빙 자료 제출·보관 동의
  evidence
  /// 상호 테스터 참여 동의
  tester
  /// 스폰서 크레딧 발급을 위한 정보 제공 동의(선택).
  /// 넘기는 것은 성명과 이메일뿐이고 스폰서는 발급·확인 목적으로만 쓴다
  /// (13 크레딧 센터 설계서 8장 · 광고용역 계약서 · 개인정보처리방침의 스폰서 표).
  /// 없으면 이메일 명단 방식의 지급 대상에서 뺀다.
  sponsor_share
}

enum NotifChannel {
  inapp
  email
  alimtalk
}

/// upheld = 어뷰징 확정(실격 유지), overturned = 플래그 취소(active 복귀)
enum AbuseStatus {
  flagged
  appealed
  upheld
  overturned
}

enum OauthProvider {
  kakao
  google
}

enum OrgType {
  public
  b2b
  edu
}

/// disabled는 시즌 종료·참가 포기로 측정을 끝낼 때만 쓴다. 실격은 사유가 되지 않는다.
enum DeployStatus {
  pending
  verifying
  active
  failed
  disabled
}

enum SslStatus {
