<?xml version="1.0" encoding="UTF-8"?>
<!--
  Workers 무료 한도 감시 — 15분마다 scripts/workers-usage-alert.sh 를 돌린다.

  설치:
    cp scripts/kr.proovit.workers-usage-alert.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/kr.proovit.workers-usage-alert.plist

  해제:
    launchctl unload ~/Library/LaunchAgents/kr.proovit.workers-usage-alert.plist

  로그: /tmp/proovit-workers-alert.log (조회 결과 한 줄씩)
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>kr.proovit.workers-usage-alert</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/sy/GitHub/proovit/scripts/workers-usage-alert.sh</string>
  </array>

  <!-- 15분마다. 개막 주에 트래픽이 몰리면 한 시간 간격으로는 늦다. -->
  <key>StartInterval</key>
  <integer>900</integer>

  <key>RunAtLoad</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/tmp/proovit-workers-alert.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/proovit-workers-alert.log</string>
</dict>
</plist>
