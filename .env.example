# PROOVIT 환경 변수 템플릿
# 이 파일을 .env 로 복사한 뒤 실제 값을 채운다. .env 는 커밋되지 않는다.
#   cp .env.example .env

# ─── 데이터베이스 ────────────────────────────────────────────
# 로컬: npx prisma dev  (Prisma가 로컬 Postgres를 띄운다)
# 운영: Neon 대시보드의 connection string
#
# 주소가 둘인 이유 — 런타임(DATABASE_URL)은 pooled(-pooler 붙은) 주소여야
# Vercel 함수가 커넥션을 고갈시키지 않는다. 반면 마이그레이션은 pooler를
# 통과하지 못하므로 direct 주소가 따로 필요하다(prisma.config.ts 주석).
# 로컬은 둘이 같아도 되고, DIRECT_URL이 없으면 DATABASE_URL로 폴백한다.
#
# ⚠️ 운영 값은 Vercel에서 못 꺼낸다. 두 변수가 Sensitive로 표시돼 있어
# `vercel env pull`을 하면 [SENSITIVE] 문자열이 내려온다 — Neon 콘솔에서 받을 것.
DATABASE_URL="postgresql://user:password@localhost:5432/proovit?schema=public"
DIRECT_URL=""

# 운영 DB의 pooled 주소. 로컬(.env.development.local)과 스테이징(Vercel Preview,
# dev 브랜치 한정)에 넣는다. 사전 신청 수는 KPI#1이라 운영 행만 뜻이 있는데,
# 로컬·스테이징은 dev DB를 읽어 테스트 리드까지 세므로 Neon과 숫자가 어긋난다.
# 이 값이 있으면 운영자 헤더·대시보드 KPI 카드·사전신청 리드 화면(카드·표·CSV)이
# 운영 DB를 읽는다(src/lib/prod-leads.ts). 읽기만 하고, 없으면 자기 DB로 돌아간다.
# 운영 배포에는 넣지 않는다.
PROD_DATABASE_URL=""

# ─── 사이트 ─────────────────────────────────────────────────
# OG 카드·정규 URL 생성에 쓰인다. 로컬은 http://localhost:3000
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ─── 애널리틱스 ──────────────────────────────────────────────
# GA4 측정 ID. 09 심사 기준서가 유효 방문자를 "GA4 일별 활성 사용자 합"으로
# 고정했으므로 이 계측이 곧 심사 근거다.
#
# 로컬·프리뷰에서는 비워둔다. 값이 없으면 태그를 심지 않는다 —
# 개발 중 방문이 운영 집계에 섞이면 되돌릴 수 없다.
# 운영(Vercel Production)에만 넣는다.
#
# ⚠️ 예외 하나 — CSP 검사(scripts/design-diff/csp.mjs)는 이 값이 있어야
# googletagmanager·google-analytics로 요청이 실제로 나가고, 그래야 CSP의 GA 줄이
# 검증된다. 비어 있으면 폰트 출처만 보고 통과해 검사가 헛돈다.
#
# 넣을 곳은 여기가 아니라 `.env.production.local`이고, 값은 **가짜 측정 ID**를 쓴다:
#
#   NEXT_PUBLIC_GA_ID=G-CSPCHECK00
#
# `.env.production.local`은 next build·next start만 읽고 next dev는 안 읽는다 —
# 개발 중 방문이 새지 않는다. 가짜 ID라도 gtag.js는 같은 호스트에서 받아오고 수집
# 요청도 같은 호스트로 나가므로 허용 목록 검증에는 차이가 없다. 진짜 ID를 쓰면
# 33개 화면의 페이지뷰가 운영 GA4에 쌓이고, GA4는 들어온 히트를 못 지운다.
NEXT_PUBLIC_GA_ID=""

# GA4 **읽기** 자격 — scripts/ga4/traffic.mjs와 운영자 헤더(src/lib/ga4.ts)가 쓴다.
# 위 NEXT_PUBLIC_GA_ID가 숫자를 쌓는 쪽이라면, 이 둘은 쌓인 숫자를 꺼내는 쪽이다.
# 헤더 쪽은 모집 전(A1) 「전환율 = 사전 신청 리드 ÷ 랜딩 방문자」의 분모만 읽고,
# 값이 없으면 그 조각을 비운다 — 로컬·프리뷰에서 비워 둬도 화면은 멀쩡하다.
# 운영에 넣으려면 Vercel 환경변수에 둘 다 올린다.
#
#   node --env-file=.env.local scripts/ga4/traffic.mjs
#
# 붙이는 순서(하나라도 빠지면 403이 뜨는데 메시지가 원인을 구분해 주지 않는다):
#   1. Cloud 프로젝트에서 Analytics Data API 사용 설정
#   2. 서비스 계정 생성 → JSON 키 발급
#   3. GA4 관리 → 속성 액세스 관리 → 그 서비스 계정 이메일을 **뷰어**로 추가
#
# ⚠️ GA4_PROPERTY_ID는 측정 ID(G-…)가 아니라 **숫자** 속성 ID다.
#    GA4 관리 → 속성 세부정보 오른쪽 위에 있다. 헷갈리면 403으로 나타나
#    권한 문제로 오진하기 쉬워서 스크립트가 먼저 막는다.
#
# ⚠️ 키 JSON은 줄바꿈 때문에 한 줄로 넣기 번거롭다. base64도 받는다:
#      base64 -i key.json | pbcopy
#    파일로 두지 않는 이유는 .gitignore가 `.env*`만 막기 때문이다 —
#    키 파일을 새로 만들면 무시 규칙도 새로 만들어야 하고, 그 규칙이
#    지워지는 날 키가 커밋된다.
GA4_PROPERTY_ID=""
GA4_SA_KEY=""

# ─── 봇 방지 (Cloudflare Turnstile) ──────────────────────────
# 06 §12가 레이트리밋과 함께 요구한다. 사전신청 수가 KPI#1이자 지원서 제출 수치라
# 분산 IP 봇 한 번이면 집계가 오염되고 되돌릴 수 없다.
#
# 두 값이 비어 있으면 검증을 통째로 건너뛴다 — 도입 전에는 지금과 똑같이 동작한다.
# 키를 넣는 순간부터 fail-closed로 바뀐다(검증 실패·API 장애 모두 거절).
#
# 발급: Cloudflare 대시보드 → Turnstile → Add site
#
# CSP 검사도 NEXT_PUBLIC_TURNSTILE_SITE_KEY를 쓴다 — 위 애널리틱스 항목의
# `.env.production.local` 설명을 같이 볼 것. 이쪽은 진짜 사이트 키를 넣어도 된다
# (브라우저로 나가는 공개 값이고 쌓이는 데이터가 없다). 시크릿 키는 검사에 필요 없다.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# ─── 레이트리밋 (Upstash Redis) ─────────────────────────────
# POST /api/leads 를 IP당 10분 10건으로 제한한다. 06 §12가 Turnstile과 함께
# 요구하는데, 막으려는 것은 서버 부하가 아니라 KPI 오염이다 — 사전신청 수가
# 시즌1 KPI#1이자 지원사업 제출 수치라 봇이 부풀리면 근거 자체가 못 쓰게 된다.
#
# 두 값이 비어 있으면 인스턴스 메모리 폴백으로 내려간다. 서버리스에서는
# 인스턴스 수만큼 한도가 곱해지고 콜드스타트마다 초기화되므로 **정확한 방어가 아니다.**
# 운영에는 반드시 넣는다. 발급: Upstash 콘솔 → Redis → REST API
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ─── 리더보드 롤업 크론 ─────────────────────────────────────
# POST /api/v1/cron/rollup 을 여는 열쇠. 15분마다 외부 크론이 이 키로 부른다.
#
# **비어 있으면 그 주소는 404다.** 키 없이 열린 채로 도는 것이 제일 나쁘다 —
# 아무나 집계를 돌릴 수 있으면 「조작 불가능한 지표」가 성립하지 않는다.
#   openssl rand -base64 32
CRON_SECRET=""

# ─── 측정 프록시 (클라우드플레어 워커) ──────────────────────
# 워커가 우리 API 둘을 부를 때 쓰는 열쇠 — 라우트 표 조회와 방문 이벤트 수집.
# 워커 쪽에도 같은 값을 넣는다(`npx wrangler secret put MEASURE_SECRET`).
#
# **비어 있으면 두 주소 다 404다.** 열려 있으면 아무나 남의 팀 방문자 수를
# 올릴 수 있고, 그 순간 「참가자가 만질 수 없는 숫자」가 거짓이 된다.
#   openssl rand -base64 32
MEASURE_SECRET=""

# ─── 인증 (Auth.js) ─────────────────────────────────────────
# 세션 토큰·이메일 인증 토큰을 서명하는 키. 없으면 인증이 통째로 뜨지 않는다.
#   openssl rand -base64 32
AUTH_SECRET=""

# 카카오·구글 앱 자격증명. 두 값이 다 있는 제공자만 로그인 버튼으로 나온다 —
# 앱 등록 전에도 배포가 깨지지 않게 하려는 것이다(Turnstile과 같은 방식).
#
# 콜백 주소로 등록할 것:
#   https://<배포 주소>/api/auth/callback/kakao
#   https://<배포 주소>/api/auth/callback/google
# 로컬은 http://localhost:3000/api/auth/callback/... 을 따로 등록한다.
# ⚠️ 카카오는 아직 채우지 말 것 (2026-08-12).
# 카카오 앱 등록은 끝났지만 「카카오계정(이메일)」 동의항목이 잠겨 있다 —
# 비즈 앱 전환 + 비즈니스 정보 심사를 통과해야 열린다. users.email이 NOT NULL이라
# 이메일 없이는 가입 자체가 성립하지 않는다(어댑터가 명시적으로 막는다).
# 심사가 끝나면 두 값을 넣는 것만으로 로그인 버튼이 생긴다.
AUTH_KAKAO_ID=""
AUTH_KAKAO_SECRET=""

AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ─── 메일 발송 (Resend) ─────────────────────────────────────
# 06 ARCHITECTURE가 지정한 서비스. 심사 결과·마감 통지·팀 초대·환불 안내가 나간다.
# 마감 기반 서비스라 통지 도달 여부가 곧 분쟁의 근거다.
#
# ⚠️ 도메인 검증(DKIM·SPF·MX)이 선행이다. `proovit.kr` 확보(WBS B2) 전에는
# 자기 주소로 보내는 테스트만 가능하다 — 즉 메일 기능은 도메인에 종속된다.
#
# ⚠️ 무료 한도는 월 3,000통 · **하루 100통**이다. 시즌1 모집 오픈 때
# 사전신청자에게 일괄 발송하면 하루 한도에 걸린다. 나눠 보내거나 그 시점에 유료 전환할 것.
#
# ⚠️ 도메인 리전은 기본값(us-east-1)을 그대로 둔다. 다른 리전을 고르면
# 개인정보처리방침 제7조 국외 이전 표에 나라가 하나 더 늘어나는데, 계정 데이터와
# 로그는 어차피 미국에 남아서 미국은 빠지지 않는다. 트랜잭션 메일이라 지연도 무의미하다.
# (Upstash Regional DB를 검토하다 같은 이유로 접었던 것과 같은 판단이다)
RESEND_API_KEY=""

# 개발 서버에서도 메일이 **진짜로 나간다**(기본값). 도달을 봐야 해서 그렇다.
# ⚠️ 그래서 팀원 초대 칸에는 내가 받을 수 있는 주소만 넣는다 — 남의 주소로
# 나가면 되돌릴 수 없다. 끄고 싶은 날만 0으로 둔다. 테스트(NODE_ENV=test)는
# 이 값과 무관하게 언제나 막힌다.
MAIL_LIVE=""

# ─── 증빙 파일 (Cloudflare R2) ──────────────────────────────
# 스테이지 제출의 증빙 파일과 s1 「문제 정의 상세」의 파일이 여기 들어간다.
# 06 ARCHITECTURE가 지정한 저장소(무료 10GB, 이그레스 무료). S3 호환 API로
# 붙으며 SDK 없이 aws4fetch로 서명만 한다(src/lib/evidence-storage.ts).
#
# 넷 다 비면 개발 서버는 리포의 .data/evidence/ 에 쓴다(gitignore). 운영에서
# 비면 업로드가 「저장소가 아직 연결되지 않았어요」로 막힌다 — 서버리스 디스크에
# 쓰는 척하지 않는다.
#
# 버킷은 **비공개**로 둔다. 파일은 /api/evidence/{key}가 팀원·운영자만 확인한 뒤
# 5분짜리 서명 주소로 연다. 공개 주소·커스텀 도메인을 붙이지 않는다.
# 토큰 권한은 그 버킷 하나에 「Object Read & Write」면 된다.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
