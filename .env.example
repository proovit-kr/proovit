# PROOVIT 환경 변수 템플릿
# 이 파일을 .env 로 복사한 뒤 실제 값을 채운다. .env 는 커밋되지 않는다.
#   cp .env.example .env

# ─── 데이터베이스 ────────────────────────────────────────────
# 로컬: npx prisma dev  (Prisma가 로컬 Postgres를 띄운다)
# 운영: Neon 대시보드의 connection string
DATABASE_URL="postgresql://user:password@localhost:5432/proovit?schema=public"

# ─── 사이트 ─────────────────────────────────────────────────
# OG 카드·정규 URL 생성에 쓰인다. 로컬은 http://localhost:3000
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ─── 애널리틱스 ──────────────────────────────────────────────
# GA4 측정 ID. 09 심사 기준서가 유효 방문자를 "GA4 일별 활성 사용자 합"으로
# 고정했으므로 이 계측이 곧 심사 근거다.
#
# 로컬·프리뷰에서는 비워둔다. 값이 없으면 태그를 심지 않는다 —
# 개발 중 방문이 운영 집계에 섞이면 되돌릴 수 없다.
# 운영(Vercel Production)에만 넣는다.
NEXT_PUBLIC_GA_ID=""

# ─── 봇 방지 (Cloudflare Turnstile) ──────────────────────────
# 06 §12가 레이트리밋과 함께 요구한다. 사전신청 수가 KPI#1이자 지원서 제출 수치라
# 분산 IP 봇 한 번이면 집계가 오염되고 되돌릴 수 없다.
#
# 두 값이 비어 있으면 검증을 통째로 건너뛴다 — 도입 전에는 지금과 똑같이 동작한다.
# 키를 넣는 순간부터 fail-closed로 바뀐다(검증 실패·API 장애 모두 거절).
#
# 발급: Cloudflare 대시보드 → Turnstile → Add site
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# ─── 인증 (Auth.js) ─────────────────────────────────────────
# 세션 토큰·이메일 인증 토큰을 서명하는 키. 없으면 인증이 통째로 뜨지 않는다.
#   openssl rand -base64 32
AUTH_SECRET=""

# 카카오·구글 앱 자격증명. 두 값이 다 있는 제공자만 로그인 버튼으로 나온다 —
# 앱 등록 전에도 배포가 깨지지 않게 하려는 것이다(Turnstile과 같은 방식).
#
# 콜백 주소로 등록할 것:
#   https://<배포 주소>/api/auth/callback/kakao
#   https://<배포 주소>/api/auth/callback/google
# 로컬은 http://localhost:3000/api/auth/callback/... 을 따로 등록한다.
AUTH_KAKAO_ID=""
AUTH_KAKAO_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ─── 이후 주차에 추가 예정 ───────────────────────────────────
# W3 증빙 업로드 (Cloudflare R2)
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET=""
#
# W4 메일 발송 (Resend)
# RESEND_API_KEY=""
