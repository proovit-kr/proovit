# PROOVIT 환경 변수 템플릿
# 이 파일을 .env 로 복사한 뒤 실제 값을 채운다. .env 는 커밋되지 않는다.
#   cp .env.example .env

# ─── 데이터베이스 ────────────────────────────────────────────
# 로컬: npx prisma dev  (Prisma가 로컬 Postgres를 띄운다)
# 운영: Neon 대시보드의 connection string
DATABASE_URL="postgresql://user:password@localhost:5432/proovit?schema=public"

# ─── 사이트 ─────────────────────────────────────────────────
# OG 카드·정규 URL 생성에 쓰인다. 로컬은 http://localhost:3000
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ─── 이후 주차에 추가 예정 ───────────────────────────────────
# W2 인증 (Auth.js)
# AUTH_SECRET=""
# AUTH_KAKAO_ID=""
# AUTH_KAKAO_SECRET=""
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""
#
# W3 증빙 업로드 (Cloudflare R2)
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET=""
#
# W4 메일 발송 (Resend)
# RESEND_API_KEY=""
