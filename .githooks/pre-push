#!/bin/sh
#
# main·dev로 가는 push를 거부한다.
#
# 운영이 main에서, 스테이징이 dev에서 나간다. 조직이 GitHub Free이고 리포가 비공개라 서버 쪽
# 브랜치 보호를 걸 수 없어서(403), 이 훅이 유일한 방어선이다.
#
# 켜기:  git config core.hooksPath .githooks
# 우회:  git push --no-verify   ← 정말 아는 경우에만
#
# pre-push는 stdin으로 "<로컬ref> <로컬sha> <원격ref> <원격sha>" 줄을 받는다.

protected="main dev"

while read -r _local_ref _local_sha remote_ref _remote_sha; do
	for branch in $protected; do
		if [ "$remote_ref" = "refs/heads/$branch" ]; then
			echo "" >&2
			echo "  거부: $branch 에 직접 push하지 않는다." >&2
			echo "  main은 운영, dev는 스테이징으로 리뷰 없이 배포된다." >&2
			echo "" >&2
			echo "  dev에서 브랜치를 따서 PR로 보낸다:" >&2
			echo "    git switch -c <브랜치명> origin/dev" >&2
			echo "    git push -u origin <브랜치명>" >&2
			echo "    gh pr create" >&2
			echo "" >&2
			exit 1
		fi
	done
done
